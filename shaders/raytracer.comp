// shaders/raytracer.comp
#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, set = 0, binding = 0) uniform image2D outImage;
layout(push_constant) uniform PushConstants {

    uint frameCount;

} pc;

struct Ray {

    vec3 origin;
    vec3 dir;


};

// A wall
struct Plane {

    vec3 normal;
    float d;
    vec3 color;
    float emission;

};

// ------------- RANDOM -------------

// claude stuff
uint rngState;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand() {
    rngState = pcg(rngState);
    return float(rngState) / float(0xFFFFFFFFu);
}

vec3 randomHemisphere(vec3 normal) {
    float u1 = rand();
    float u2 = rand();

    float r   = sqrt(u1);
    float phi = 2.0 * 3.14159265 * u2;

    vec3 localDir = vec3(r * cos(phi), r * sin(phi), sqrt(1.0 - u1));

    vec3 up      = abs(normal.y) < 0.9 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitang  = cross(normal, tangent);

    return normalize(tangent * localDir.x + bitang * localDir.y + normal * localDir.z);
}



const int NUM_PLANES = 6; // Cornell box

Plane planes[NUM_PLANES] = Plane[](

    Plane(vec3( 1, 0, 0), -1.0, vec3(0.8, 0.1, 0.1), 0),
    Plane(vec3(-1, 0, 0), -1.0, vec3(0.1, 0.8, 0.1), 0),
    Plane(vec3( 0,-1, 0), -2.0, vec3(0.8, 0.8, 0.8), 5.0),
    Plane(vec3( 0, 1, 0),  0.0, vec3(0.8, 0.8, 0.8), 0),
    Plane(vec3( 0, 0,-1), -4.0, vec3(0.8, 0.8, 0.8), 0),
    Plane(vec3( 0, 0, 1),  0.0, vec3(0.0, 0.0, 0.0), 0) 

);

Ray generateRay(ivec2 pixel, ivec2 size){

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size) *2.0 - 1.0;
    uv.x *= float(size.x) / float(size.y);

    vec3 cameraPos = vec3(0.0, 1.0, -3.0);

    Ray ray;
    ray.origin = cameraPos;
    ray.dir = normalize(vec3(uv.x, uv.y, 1.0));
    return ray;

}

float intersectPlane(Ray ray, Plane plane) {
    
    float denom = dot(plane.normal, ray.dir);

    if (abs(denom) < 1e-6) return -1.0; 
    
    float t = (plane.d - dot(plane.normal, ray.origin)) / denom;
    
    return t > 0.0 ? t : -1.0;

}

vec3 tracePath(Ray ray) {
    
    vec3 throughput = vec3(1.0); 
    vec3 color = vec3(0.0);

    const int MAX_BOUNCES = 4;

    for (int bounce = 0; bounce < MAX_BOUNCES; bounce++) {

        float tMin    = 1e20;
        int   hitIdx  = -1;

        for (int i = 0; i < NUM_PLANES; i++) {
        
            float t = intersectPlane(ray, planes[i]);
            
            if (t > 0.0 && t < tMin) {
                tMin   = t;
                hitIdx = i;
            }
        
        }
       
        if (hitIdx == -1) {
        
            break;
        
        }

        Plane hit = planes[hitIdx];

        if (hit.emission > 0.0) {
        
            color += throughput * hit.color * hit.emission;
            break;
        
        }
       
        vec3 hitPoint = ray.origin + tMin * ray.dir;
        vec3 normal   = hit.normal;

        ray.origin = hitPoint;
        ray.dir    = randomHemisphere(normal);
        
        throughput *= hit.color;
    
        float p = max(throughput.r, max(throughput.g, throughput.b));
        
        if (rand() > p) break;
        
        throughput /= p;
    }

    return color;

}

void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(outImage);

    rngState = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pc.frameCount * 26699u + 1u;

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    const int SAMPLES = 4;
    
    vec3 col = vec3(0.0);
    

    for (int s = 0; s < SAMPLES; s++) {
    
        Ray ray = generateRay(pixel, size);
        col += tracePath(ray);
    
    }

    col /= float(SAMPLES);

    vec3 oldColor = imageLoad(outImage, pixel).rgb;

    vec3 accumulated = (oldColor * float(pc.frameCount) + col) / float(pc.frameCount + 1);

    imageStore(outImage, pixel, vec4(accumulated, 1.0));

}