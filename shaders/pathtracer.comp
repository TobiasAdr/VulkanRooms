    uint  useRealLens;
    uint  useTAA;
    uint samples;
    float focalLength;
    float apertureSize;
} pc;


layout(binding = 1) readonly buffer TriangleBuffer {

    Triangle triangles[];

} triBuffer;

layout(binding = 2) readonly buffer BVHBuffer {

    BVHNode nodes[];

} bvhBuffer;

layout(binding = 3) uniform CameraUBO {
