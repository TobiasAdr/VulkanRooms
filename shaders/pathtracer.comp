#version 450

//==============================================================================

struct Triangle { vec4 v0, v1, v2, normal; };
struct BVHNode {
    vec3 aabbMin; int leftChild;
    vec3 aabbMax; int rightChild;
    int triangleStart, triangleCount;
};

struct GpuLight {
    vec4 minP;
    vec4 maxP;
    vec4 radiance;
};

//==============================================================================

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, set = 0, binding = 0) uniform image2D outputImage;

layout(binding = 1) readonly buffer TriangleBuffer { Triangle triangles[]; } triBuffer;
layout(binding = 2) readonly buffer BVHBuffer { BVHNode nodes[]; } bvhBuffer;

layout(binding = 3) uniform CameraUBO {
    vec4 position;
    vec4 forward;
    vec4 right;
    vec4 up;
    vec4 prevPosition;
    vec4 prevForward;
    vec4 prevRight;
    vec4 prevUp;
} camera;

layout(rgba32f, set = 0, binding = 4) uniform image2D previousFrameImage;
layout(rgba32f, set = 0, binding = 5) uniform writeonly image2D gNormalDepth;
layout(rgba32f, set = 0, binding = 6) uniform writeonly image2D gAlbedo;

layout(binding = 7) readonly buffer LightBuffer {
    int count;
    GpuLight lights[];
} lightBuffer;

layout(push_constant) uniform PushConstants {
    uint jittering;
    uint frameCount;
    uint lightMode;
    uint useRealLens;
    uint useTAA;
    uint samples;
    float focalLength;
    float apertureSize;
    uint useAtrous;
    int atrousIterations;
    uint useGlossyTest;
    int maxBounces;
    uint useClamp;
    uint useBVH;
    uint debugHeatmap;
    float heatmapMax;
} pc;

//==============================================================================

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct HitInfo {
    float t;
    vec3 normal;
    vec3 color;
    bool isLight;
    float roughness;
    bool isGlossy;
};

//==============================================================================

const float CELL_SIZE = 4.0;
const float ROOM_H = 2.4;
const float WALL_THICKNESS = 0.32;
const float DOOR_W = 1.3;
const float DOOR_H = 1.95;

const int WALL_RIGHT = 1;
const int WALL_LEFT = 2;
const int WALL_FAR = 4;
const int WALL_NEAR = 8;
const int ROOM_LIGHT = 16;
const int PILLAR = 32;
const int DOOR_X = 64;
const int DOOR_Z = 128;

const int MAP_W = 6;
const int MAP_H = 6;

const int levelMap[36] = int[](
    WALL_NEAR | WALL_LEFT | WALL_FAR,
    WALL_NEAR | WALL_RIGHT | DOOR_X,
    WALL_NEAR | WALL_LEFT | ROOM_LIGHT,
    WALL_NEAR | WALL_FAR,
    WALL_NEAR | WALL_RIGHT,
    WALL_NEAR | WALL_RIGHT | WALL_FAR | ROOM_LIGHT,

    WALL_LEFT | WALL_NEAR | PILLAR,
    WALL_RIGHT | WALL_FAR | DOOR_Z,
    WALL_LEFT | WALL_FAR,
    WALL_RIGHT | WALL_NEAR | PILLAR,
    WALL_LEFT,
    WALL_RIGHT | WALL_FAR,

    WALL_LEFT | WALL_FAR | ROOM_LIGHT,
    WALL_NEAR | WALL_RIGHT | DOOR_X,
    WALL_LEFT | WALL_FAR,
    WALL_FAR | PILLAR,
    WALL_RIGHT | ROOM_LIGHT,
    WALL_RIGHT | WALL_FAR,

    WALL_LEFT | WALL_NEAR,
    WALL_RIGHT | WALL_FAR | PILLAR,
    WALL_LEFT | WALL_NEAR | ROOM_LIGHT,
    WALL_NEAR | WALL_RIGHT | DOOR_X,
    WALL_LEFT | WALL_FAR,
    WALL_RIGHT | WALL_FAR,

    WALL_LEFT | WALL_FAR | PILLAR,
    WALL_NEAR | WALL_RIGHT,
    WALL_LEFT | WALL_FAR,
    WALL_RIGHT | WALL_NEAR | ROOM_LIGHT,
    WALL_FAR | PILLAR,
    WALL_RIGHT,

    WALL_FAR | WALL_LEFT | WALL_NEAR,
    WALL_FAR | WALL_RIGHT | DOOR_X,
    WALL_FAR | WALL_LEFT,
    WALL_FAR | WALL_RIGHT | WALL_NEAR,
    WALL_FAR | WALL_LEFT | ROOM_LIGHT,
    WALL_FAR | WALL_RIGHT | WALL_NEAR
);

const vec3 WALL_COLOR  = vec3(0.78, 0.72, 0.38);
const vec3 FLOOR_COLOR = vec3(0.58, 0.51, 0.27);
const vec3 ROOF_COLOR  = vec3(0.70, 0.67, 0.48);
const vec3 LIGHT_COLOR      = vec3(1.00, 0.99, 0.94);
const vec3 LIGHT_RADIANCE   = vec3(26.0, 25.0, 21.0);
const vec3 BACKGROUND_COLOR = vec3(0.08, 0.08, 0.03);

const vec3 GLOSSY_COLOR          = vec3(0.95, 0.95, 0.97);
const float GLOSSY_ROUGHNESS     = 0.05;
const vec3 SMALL_LIGHT_RADIANCE  = vec3(120.0, 114.0, 102.0);
const vec3 SMALL_LIGHT_MIN       = vec3(11.85, ROOM_H, 11.85);
const vec3 SMALL_LIGHT_MAX       = vec3(12.15, ROOM_H, 12.15);

const int MAX_LIGHTS = 64;
const float HISTORY_WEIGHT = 0.9;
const float HISTORY_WEIGHT_NEW = 0.55;
const float DEPTH_REJECT_TOL = 0.05;
const float PI = 3.14159265;

const float DIRECT_CLAMP = 20.0;
const float ACCUM_CLAMP = 10.0;

//==============================================================================

uint rngState;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat() {
    rngState = pcgHash(rngState);
    return float(rngState) / float(0xFFFFFFFFu);
}

//==============================================================================

void buildBasis(vec3 normal, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(normal.y) < 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    tangent = normalize(cross(up, normal));
    bitangent = cross(normal, tangent);
}

vec3 cosineSampleHemisphere(vec3 normal) {
    float u1 = randomFloat();
    float u2 = randomFloat();
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3 local = vec3(r * cos(phi), r * sin(phi), sqrt(1.0 - u1));
    vec3 tangent, bitangent;
    buildBasis(normal, tangent, bitangent);
    return normalize(tangent * local.x + bitangent * local.y + normal * local.z);
}

vec3 sampleGGXHalfVector(vec3 normal, float roughness) {
    float a = roughness * roughness;
    float u1 = randomFloat();
    float u2 = randomFloat();
    float phi = 2.0 * PI * u1;
    float cosTheta = sqrt((1.0 - u2) / (1.0 + (a * a - 1.0) * u2));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3 local = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    vec3 tangent, bitangent;
    buildBasis(normal, tangent, bitangent);
    return normalize(tangent * local.x + bitangent * local.y + normal * local.z);
}

//==============================================================================

float ggxD(vec3 normal, vec3 h, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(normal, h), 0.0);
    float d = (NdotH * NdotH * (a2 - 1.0) + 1.0);
    return a2 / max(PI * d * d, 1e-7);
}

float ggxSmithG1(vec3 normal, vec3 v, float roughness) {
    float a = roughness * roughness;
    float NdotV = max(dot(normal, v), 0.0);
    float denom = NdotV + sqrt(a * a + (1.0 - a * a) * NdotV * NdotV);
    return 2.0 * NdotV / max(denom, 1e-7);
}

float ggxSmithG(vec3 normal, vec3 wi, vec3 wo, float roughness) {
    return ggxSmithG1(normal, wi, roughness) * ggxSmithG1(normal, wo, roughness);
}

float glossyPdf(vec3 normal, vec3 wo, vec3 wi, float roughness) {
    vec3 h = normalize(wo + wi);
    float D = ggxD(normal, h, roughness);
    float NdotH = max(dot(normal, h), 0.0);
    float VdotH = max(dot(wo, h), 0.0);
    return (D * NdotH) / max(4.0 * VdotH, 1e-7);
}

vec3 glossyBrdf(vec3 normal, vec3 wo, vec3 wi, float roughness, vec3 specColor) {
    vec3 h = normalize(wo + wi);
    float D = ggxD(normal, h, roughness);
    float G = ggxSmithG(normal, wi, wo, roughness);
    float NdotV = max(dot(normal, wo), 0.0);
    float NdotL = max(dot(normal, wi), 0.0);
    float denom = 4.0 * NdotV * NdotL;
    return specColor * (D * G) / max(denom, 1e-7);
}

//==============================================================================

bool intersectQuad(Ray ray, vec3 minP, vec3 maxP, vec3 normal, vec3 color, bool isLight, inout HitInfo hit) {
    float denom = dot(normal, ray.dir);
    if (abs(denom) < 0.0001) return false;

    vec3 planePoint = (minP + maxP) * 0.5;
    float t = (dot(normal, planePoint) - dot(normal, ray.origin)) / denom;
    if (t < 0.001 || t >= hit.t) return false;

    vec3 p = ray.origin + t * ray.dir;

    if (abs(normal.x) > 0.5) {
        if (p.y < minP.y || p.y > maxP.y || p.z < minP.z || p.z > maxP.z) return false;
    } else if (abs(normal.y) > 0.5) {
        if (p.x < minP.x || p.x > maxP.x || p.z < minP.z || p.z > maxP.z) return false;
    } else {
        if (p.x < minP.x || p.x > maxP.x || p.y < minP.y || p.y > maxP.y) return false;
    }

    hit.t = t;
    hit.normal = denom < 0.0 ? normal : -normal;
    hit.color = color;
    hit.isLight = isLight;
    hit.isGlossy = false;
    hit.roughness = 1.0;
    return true;
}

bool intersectGlossyQuad(Ray ray, vec3 minP, vec3 maxP, vec3 normal, vec3 color, inout HitInfo hit) {
    
    float denom = dot(normal, ray.dir);
    if (abs(denom) < 0.0001) return false;

    vec3 planePoint = (minP + maxP) * 0.5;
    float t = (dot(normal, planePoint) - dot(normal, ray.origin)) / denom;
    if (t < 0.001 || t >= hit.t) return false;

    vec3 p = ray.origin + t * ray.dir;

    if (abs(normal.x) > 0.5) {
        if (p.y < minP.y || p.y > maxP.y || p.z < minP.z || p.z > maxP.z) return false;
    } else if (abs(normal.y) > 0.5) {
        if (p.x < minP.x || p.x > maxP.x || p.z < minP.z || p.z > maxP.z) return false;
    } else {
        if (p.x < minP.x || p.x > maxP.x || p.y < minP.y || p.y > maxP.y) return false;
    }

    hit.t = t;
    hit.normal = denom < 0.0 ? normal : -normal;
    hit.color = color;
    hit.isLight = false;
    hit.isGlossy = true;
    hit.roughness = GLOSSY_ROUGHNESS;
    return true;

}

bool intersectBox(Ray ray, vec3 bMin, vec3 bMax, vec3 color, inout HitInfo hit) {
    
    vec3 safeDir = mix(sign(ray.dir) * 1e-5, ray.dir, greaterThan(abs(ray.dir), vec3(1e-5)));
    vec3 invDir = 1.0 / safeDir;
    vec3 t0 = (bMin - ray.origin) * invDir;
    vec3 t1 = (bMax - ray.origin) * invDir;
    vec3 tNear = min(t0, t1);
    vec3 tFar  = max(t0, t1);

    float tEnter = max(max(tNear.x, tNear.y), tNear.z);
    float tExit  = min(min(tFar.x, tFar.y), tFar.z);

    if (tEnter > tExit || tExit < 0.001) return false;

    float t = tEnter > 0.001 ? tEnter : tExit;
    if (t < 0.001 || t >= hit.t) return false;

    vec3 norm = vec3(0.0);
    if (tEnter > 0.001) {
        if (tNear.x > tNear.y && tNear.x > tNear.z)      norm = vec3(-sign(ray.dir.x), 0.0, 0.0);
        else if (tNear.y > tNear.z)                     norm = vec3(0.0, -sign(ray.dir.y), 0.0);
        else                                            norm = vec3(0.0, 0.0, -sign(ray.dir.z));
    } else {
        if (tFar.x < tFar.y && tFar.x < tFar.z)          norm = vec3(sign(ray.dir.x), 0.0, 0.0);
        else if (tFar.y < tFar.z)                       norm = vec3(0.0, sign(ray.dir.y), 0.0);
        else                                            norm = vec3(0.0, 0.0, sign(ray.dir.z));
    }

    hit.t = t;
    hit.normal = dot(norm, ray.dir) < 0.0 ? norm : -norm;
    hit.color = color;
    hit.isLight = false;
    hit.isGlossy = false;
    hit.roughness = 1.0;
    return true;

}

bool intersectDoorWallX(Ray ray, vec3 o, float halfT, inout HitInfo hit) {
    bool didHit = false;
    float d0 = (CELL_SIZE - DOOR_W) * 0.5;
    float d1 = d0 + DOOR_W;

    didHit = intersectBox(ray, o, o + vec3(halfT, ROOM_H, d0), WALL_COLOR, hit) || didHit;
    didHit = intersectBox(ray, o + vec3(0.0, 0.0, d1), o + vec3(halfT, ROOM_H, CELL_SIZE), WALL_COLOR, hit) || didHit;
    didHit = intersectBox(ray, o + vec3(0.0, DOOR_H, d0), o + vec3(halfT, ROOM_H, d1), WALL_COLOR, hit) || didHit;
    return didHit;
}

bool intersectDoorWallZ(Ray ray, vec3 o, float halfT, inout HitInfo hit) {
    bool didHit = false;
    float d0 = (CELL_SIZE - DOOR_W) * 0.5;
    float d1 = d0 + DOOR_W;

    didHit = intersectBox(ray, o, o + vec3(d0, ROOM_H, halfT), WALL_COLOR, hit) || didHit;
    didHit = intersectBox(ray, o + vec3(d1, 0.0, 0.0), o + vec3(CELL_SIZE, ROOM_H, halfT), WALL_COLOR, hit) || didHit;
    didHit = intersectBox(ray, o + vec3(d0, DOOR_H, 0.0), o + vec3(d1, ROOM_H, halfT), WALL_COLOR, hit) || didHit;
    return didHit;
}

//==============================================================================

bool intersectCell(Ray ray, int col, int row, inout HitInfo hit) {
    if (col < 0 || col >= MAP_W || row < 0 || row >= MAP_H) return false;

    int type = levelMap[row * MAP_W + col];
    vec3 o = vec3(float(col), 0.0, float(row)) * CELL_SIZE;

    bool hasLight = (type & ROOM_LIGHT) != 0;
    bool hasPillar = (type & PILLAR) != 0;

    bool hasRight = (type & WALL_RIGHT) != 0 || (col + 1 < MAP_W && (levelMap[row * MAP_W + col + 1] & WALL_LEFT) != 0);
    bool hasLeft  = (type & WALL_LEFT)  != 0 || (col > 0        && (levelMap[row * MAP_W + col - 1] & WALL_RIGHT) != 0);
    bool hasFar   = (type & WALL_FAR)   != 0 || (row + 1 < MAP_H && (levelMap[(row + 1) * MAP_W + col] & WALL_NEAR) != 0);
    bool hasNear  = (type & WALL_NEAR)  != 0 || (row > 0        && (levelMap[(row - 1) * MAP_W + col] & WALL_FAR) != 0);

    bool doorLeft  = (type & DOOR_X) != 0 || (col > 0 && (levelMap[row * MAP_W + col - 1] & DOOR_X) != 0);
    bool doorRight = (type & DOOR_X) != 0 || (col + 1 < MAP_W && (levelMap[row * MAP_W + col + 1] & DOOR_X) != 0);
    bool doorNear  = (type & DOOR_Z) != 0 || (row > 0 && (levelMap[(row - 1) * MAP_W + col] & DOOR_Z) != 0);
    bool doorFar   = (type & DOOR_Z) != 0 || (row + 1 < MAP_H && (levelMap[(row + 1) * MAP_W + col] & DOOR_Z) != 0);

    bool didHit = false;

    bool glossyFloor = (pc.useGlossyTest == 1) && (col == 2 || col == 3) && (row == 2 || row == 3);
    if (glossyFloor) {
        didHit = intersectGlossyQuad(ray, o, o + vec3(CELL_SIZE, 0.0, CELL_SIZE), vec3(0, 1, 0), GLOSSY_COLOR, hit) || didHit;
    } else {
        didHit = intersectQuad(ray, o, o + vec3(CELL_SIZE, 0.0, CELL_SIZE), vec3(0, 1, 0), FLOOR_COLOR, false, hit) || didHit;
    }

    if (hasLight) {
        vec3 lMin = o + vec3(1.6, ROOM_H, 1.6);
        vec3 lMax = o + vec3(2.4, ROOM_H, 2.4);

        didHit = intersectQuad(ray, lMin, lMax, vec3(0, -1, 0), LIGHT_COLOR, true, hit) || didHit;
        didHit = intersectQuad(ray, o + vec3(0, ROOM_H, 0), vec3(o.x + CELL_SIZE, ROOM_H, lMin.z), vec3(0, -1, 0), ROOF_COLOR, false, hit) || didHit;
        didHit = intersectQuad(ray, vec3(o.x, ROOM_H, lMax.z), o + vec3(CELL_SIZE, ROOM_H, CELL_SIZE), vec3(0, -1, 0), ROOF_COLOR, false, hit) || didHit;
        didHit = intersectQuad(ray, vec3(o.x, ROOM_H, lMin.z), vec3(lMin.x, ROOM_H, lMax.z), vec3(0, -1, 0), ROOF_COLOR, false, hit) || didHit;
        didHit = intersectQuad(ray, vec3(lMax.x, ROOM_H, lMin.z), vec3(o.x + CELL_SIZE, ROOM_H, lMax.z), vec3(0, -1, 0), ROOF_COLOR, false, hit) || didHit;
    } else {
        didHit = intersectQuad(ray, o + vec3(0, ROOM_H, 0), o + vec3(CELL_SIZE, ROOM_H, CELL_SIZE), vec3(0, -1, 0), ROOF_COLOR, false, hit) || didHit;
    }

    float halfT = WALL_THICKNESS * 0.5;

    if (hasLeft) {
        if (col > 0 && doorLeft) didHit = intersectDoorWallX(ray, o, halfT, hit) || didHit;
        else didHit = intersectBox(ray, o, o + vec3(halfT, ROOM_H, CELL_SIZE), WALL_COLOR, hit) || didHit;
    }

    if (hasRight) {
        vec3 rO = o + vec3(CELL_SIZE - halfT, 0.0, 0.0);
        if (col < MAP_W - 1 && doorRight) didHit = intersectDoorWallX(ray, rO, halfT, hit) || didHit;
        else didHit = intersectBox(ray, rO, rO + vec3(halfT, ROOM_H, CELL_SIZE), WALL_COLOR, hit) || didHit;
    }

    if (hasNear) {
        if (row > 0 && doorNear) didHit = intersectDoorWallZ(ray, o, halfT, hit) || didHit;
        else didHit = intersectBox(ray, o, o + vec3(CELL_SIZE, ROOM_H, halfT), WALL_COLOR, hit) || didHit;
    }

    if (hasFar) {
        vec3 fO = o + vec3(0.0, 0.0, CELL_SIZE - halfT);
        if (row < MAP_H - 1 && doorFar) didHit = intersectDoorWallZ(ray, fO, halfT, hit) || didHit;
        else didHit = intersectBox(ray, fO, fO + vec3(CELL_SIZE, ROOM_H, halfT), WALL_COLOR, hit) || didHit;
    }

    if (hasPillar) {
        vec3 pMin = o + vec3(1.65, 0.0, 1.65);
        vec3 pMax = o + vec3(2.35, ROOM_H, 2.35);
        didHit = intersectBox(ray, pMin, pMax, WALL_COLOR, hit) || didHit;
    }

    return didHit;
}

bool intersectSmallLight(Ray ray, inout HitInfo hit) {
    return intersectQuad(ray, SMALL_LIGHT_MIN, SMALL_LIGHT_MAX, vec3(0, -1, 0), LIGHT_COLOR, true, hit);
}

bool traverseGrid(Ray ray, inout HitInfo hit) {

    vec3 gridMin = vec3(0.0);
    vec3 gridMax = vec3(float(MAP_W) * CELL_SIZE, ROOM_H, float(MAP_H) * CELL_SIZE);

    vec3 safeDir = mix(sign(ray.dir) * 1e-5, ray.dir, greaterThan(abs(ray.dir), vec3(1e-5)));
    vec3 invDir = 1.0 / safeDir;

    vec3 t0 = (gridMin - ray.origin) * invDir;
    vec3 t1 = (gridMax - ray.origin) * invDir;
    vec3 tNear = min(t0, t1);
    vec3 tFar  = max(t0, t1);

    float tEnter = max(max(tNear.x, tNear.y), tNear.z);
    float tExit  = min(min(tFar.x, tFar.y), tFar.z);
    if (tEnter > tExit || tExit < 0.001) return false;

    vec3 startPos = ray.origin + max(tEnter, 0.0001) * ray.dir;
    int cellX = clamp(int(floor(startPos.x / CELL_SIZE)), 0, MAP_W - 1);
    int cellZ = clamp(int(floor(startPos.z / CELL_SIZE)), 0, MAP_H - 1);

    int stepX = ray.dir.x >= 0.0 ? 1 : -1;
    int stepZ = ray.dir.z >= 0.0 ? 1 : -1;

    float dirX = abs(ray.dir.x) > 1e-5 ? ray.dir.x : 1e-5;
    float dirZ = abs(ray.dir.z) > 1e-5 ? ray.dir.z : 1e-5;
    float tDeltaX = abs(CELL_SIZE / dirX);
    float tDeltaZ = abs(CELL_SIZE / dirZ);

    float nextBoundaryX = (stepX > 0 ? float(cellX + 1) : float(cellX)) * CELL_SIZE;
    float nextBoundaryZ = (stepZ > 0 ? float(cellZ + 1) : float(cellZ)) * CELL_SIZE;

    float tMaxX = abs(ray.dir.x) > 1e-5 ? (nextBoundaryX - ray.origin.x) / ray.dir.x : 1e30;
    float tMaxZ = abs(ray.dir.z) > 1e-5 ? (nextBoundaryZ - ray.origin.z) / ray.dir.z : 1e30;

    bool didHit = false;

    while (cellX >= 0 && cellX < MAP_W && cellZ >= 0 && cellZ < MAP_H) {
        didHit = intersectCell(ray, cellX, cellZ, hit) || didHit;

        float tNextCell = min(tMaxX, tMaxZ);
        if (didHit && hit.t <= tNextCell) break;

        if (tMaxX < tMaxZ) {
            tMaxX += tDeltaX;
            cellX += stepX;
        } else {
            tMaxZ += tDeltaZ;
            cellZ += stepZ;
        }
    }

    return didHit;

}

//==============================================================================

bool hitTriangle(Ray ray, Triangle tri, inout HitInfo closest) {

    vec3 v0 = tri.v0.xyz;
    vec3 v1 = tri.v1.xyz;
    vec3 v2 = tri.v2.xyz;

    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 h = cross(ray.dir, e2);
    float a = dot(e1, h);

    if (abs(a) < 0.0001) return false;

    float f = 1.0 / a;
    vec3 s = ray.origin - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, e1);
    float v = f * dot(ray.dir, q);
    if (v < 0.0 || u + v > 1.0) return false;

    float t = f * dot(e2, q);
    if (t < 0.001 || t >= closest.t) return false;

    closest.t = t;
    closest.normal = tri.normal.xyz;
    closest.color = vec3(0.45, 0.27, 0.12);
    closest.isLight = false;
    closest.isGlossy = false;
    closest.roughness = 1.0;
    return true;

}

bool hitAABBt(Ray ray, vec3 aabbMin, vec3 aabbMax, float tMax, out float tEnter) {
    vec3 safeDir = mix(sign(ray.dir) * 1e-5, ray.dir, greaterThan(abs(ray.dir), vec3(1e-5)));
    vec3 invDir = 1.0 / safeDir;
    vec3 t0 = (aabbMin - ray.origin) * invDir;
    vec3 t1 = (aabbMax - ray.origin) * invDir;
    vec3 tMin = min(t0, t1);
    vec3 tMax3 = max(t0, t1);

    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    float tExit = min(min(tMax3.x, tMax3.y), tMax3.z);
    return tEnter <= tExit && tExit > 0.001 && tEnter < tMax;
}

bool hitLinear(Ray ray, inout HitInfo hit) {
    if (bvhBuffer.nodes.length() > 0) {
        float tEnter;
        if (!hitAABBt(ray, bvhBuffer.nodes[0].aabbMin, bvhBuffer.nodes[0].aabbMax, hit.t, tEnter)) {
            return false;
        }
    }
    bool didHit = false;
    int n = triBuffer.triangles.length();
    for (int i = 0; i < n; i++) {
        didHit = hitTriangle(ray, triBuffer.triangles[i], hit) || didHit;
    }
    return didHit;
}

bool hitBVH(Ray ray, inout HitInfo hit) {
    int totalNodes = bvhBuffer.nodes.length();
    if (totalNodes == 0) return false;

    bool didHit = false;
    int stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        if (nodeIdx < 0 || nodeIdx >= totalNodes) continue;
        BVHNode node = bvhBuffer.nodes[nodeIdx];

        float tEnter;
        if (!hitAABBt(ray, node.aabbMin, node.aabbMax, hit.t, tEnter)) continue;

        if (node.triangleCount > 0) {
            int triLimit = min(node.triangleStart + node.triangleCount, int(triBuffer.triangles.length()));
            for (int i = node.triangleStart; i < triLimit; i++) {
                didHit = hitTriangle(ray, triBuffer.triangles[i], hit) || didHit;
            }
        } else {
            int l = node.leftChild;
            int r = node.rightChild;

            float tL, tR;
            bool hitL = (l >= 0 && l < totalNodes) && hitAABBt(ray, bvhBuffer.nodes[l].aabbMin, bvhBuffer.nodes[l].aabbMax, hit.t, tL);
            bool hitR = (r >= 0 && r < totalNodes) && hitAABBt(ray, bvhBuffer.nodes[r].aabbMin, bvhBuffer.nodes[r].aabbMax, hit.t, tR);

            if (hitL && hitR) {
                if (stackPtr < 62) {
                    if (tL <= tR) { stack[stackPtr++] = r; stack[stackPtr++] = l; }
                    else          { stack[stackPtr++] = l; stack[stackPtr++] = r; }
                }
            } else if (hitL) {
                if (stackPtr < 63) stack[stackPtr++] = l;
            } else if (hitR) {
                if (stackPtr < 63) stack[stackPtr++] = r;
            }
        }
    }

    return didHit;
}

//==============================================================================

int hitLinearTests(Ray ray, inout HitInfo hit) {
    if (bvhBuffer.nodes.length() > 0) {
        float tEnter;
        if (!hitAABBt(ray, bvhBuffer.nodes[0].aabbMin, bvhBuffer.nodes[0].aabbMax, hit.t, tEnter)) {
            return 0;
        }
    }
    int tests = 0;
    int n = triBuffer.triangles.length();
    for (int i = 0; i < n; i++) {
        hitTriangle(ray, triBuffer.triangles[i], hit);
        tests++;
    }
    return tests;
}

int hitBVHTests(Ray ray, inout HitInfo hit) {

    int totalNodes = bvhBuffer.nodes.length();
    if (totalNodes == 0) return 0;

    int tests = 0;
    int stack[64];
    int sp = 0;
    stack[sp++] = 0;

    while (sp > 0) {
        int nodeIdx = stack[--sp];
        if (nodeIdx < 0 || nodeIdx >= totalNodes) continue;
        BVHNode node = bvhBuffer.nodes[nodeIdx];

        float tEnter;
        if (!hitAABBt(ray, node.aabbMin, node.aabbMax, hit.t, tEnter)) continue;

        if (node.triangleCount > 0) {
            int triLimit = min(node.triangleStart + node.triangleCount, int(triBuffer.triangles.length()));
            for (int i = node.triangleStart; i < triLimit; i++) {
                hitTriangle(ray, triBuffer.triangles[i], hit);
                tests++;
            }
        } else {
            int l = node.leftChild;
            int r = node.rightChild;

            float tL, tR;
            bool hitL = (l >= 0 && l < totalNodes) && hitAABBt(ray, bvhBuffer.nodes[l].aabbMin, bvhBuffer.nodes[l].aabbMax, hit.t, tL);
            bool hitR = (r >= 0 && r < totalNodes) && hitAABBt(ray, bvhBuffer.nodes[r].aabbMin, bvhBuffer.nodes[r].aabbMax, hit.t, tR);

            if (hitL && hitR) {
                if (sp < 62) {
                    if (tL <= tR) { stack[sp++] = r; stack[sp++] = l; }
                    else          { stack[sp++] = l; stack[sp++] = r; }
                }
            } else if (hitL) {
                if (sp < 63) stack[sp++] = l;
            } else if (hitR) {
                if (sp < 63) stack[sp++] = r;
            }
        }
    }

    return tests;

}

vec3 heatmap(float t) {
    t = clamp(t, 0.0, 1.0);
    vec3 c = vec3(0.0);
    c.b = smoothstep(0.5, 0.0, t);
    c.g = t < 0.5 ? smoothstep(0.0, 0.5, t) : smoothstep(1.0, 0.5, t);
    c.r = smoothstep(0.4, 1.0, t);
    return c;
}

//==============================================================================

bool intersectScene(Ray ray, inout HitInfo hit) {

    hit.t = 1e30;
    bool hitGrid = traverseGrid(ray, hit);
    bool hitMeshes = (pc.useBVH == 1) ? hitBVH(ray, hit) : hitLinear(ray, hit);
    bool hitSmall = (pc.useGlossyTest == 1) && intersectSmallLight(ray, hit);
    return hitGrid || hitMeshes || hitSmall;

}

//==============================================================================

Ray generateCameraRay(ivec2 pixel, ivec2 size) {
    vec2 jitter = vec2(randomFloat() - 0.5, randomFloat() - 0.5);

    vec2 uv = (pc.jittering == 1 || pc.useTAA == 1)
        ? (vec2(pixel) + 0.5 + jitter) / vec2(size) * 2.0 - 1.0
        : (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;

    uv.x *= float(size.x) / float(size.y);
    uv.y = -uv.y;

    Ray ray;

    if (pc.useRealLens == 1) {
        vec3 focalPoint = camera.position.xyz
            + camera.forward.xyz * pc.focalLength
            + uv.x * camera.right.xyz * pc.focalLength
            + uv.y * camera.up.xyz * pc.focalLength;

        float angle = randomFloat() * 2.0 * PI;
        float radius = sqrt(randomFloat()) * pc.apertureSize;
        vec2 disk = vec2(cos(angle), sin(angle)) * radius;
        vec3 lensPoint = camera.position.xyz + disk.x * camera.right.xyz + disk.y * camera.up.xyz;

        ray.origin = lensPoint;
        ray.dir = normalize(focalPoint - lensPoint);
    } else {
        ray.origin = camera.position.xyz;
        ray.dir = normalize(camera.forward.xyz + uv.x * camera.right.xyz + uv.y * camera.up.xyz);
    }

    return ray;
}

//==============================================================================

float powerHeuristic(float pdfA, float pdfB) {
    float a2 = pdfA * pdfA;
    float b2 = pdfB * pdfB;
    float denom = a2 + b2;
    return denom > 0.0 ? a2 / denom : 0.0;
}

int findLightIndex(vec3 point) {
    for (int i = 0; i < lightBuffer.count; i++) {
        if (point.x >= lightBuffer.lights[i].minP.x - 0.01 && point.x <= lightBuffer.lights[i].maxP.x + 0.01 &&
            point.z >= lightBuffer.lights[i].minP.z - 0.01 && point.z <= lightBuffer.lights[i].maxP.z + 0.01 &&
            abs(point.y - lightBuffer.lights[i].minP.y) < 0.05) {
            return i;
        }
    }
    return -1;
}

float lightSelectPdf(vec3 hitPoint, vec3 hitNormal, int chosenIdx) {
    if (lightBuffer.count == 0) return 0.0;

    float weights[MAX_LIGHTS];
    float totalWeight = 0.0;

    for (int i = 0; i < lightBuffer.count; i++) {
        vec3 lmin = lightBuffer.lights[i].minP.xyz;
        vec3 lmax = lightBuffer.lights[i].maxP.xyz;
        vec3 center = 0.5 * (lmin + lmax);
        vec3 toCenter = center - hitPoint;
        float d2 = max(dot(toCenter, toCenter), 0.01);

        vec3 d = toCenter / sqrt(d2);
        float cosTheta = max(dot(hitNormal, d), 0.0);
        float cosLight = max(dot(vec3(0.0, -1.0, 0.0), -d), 0.0);
        float area = (lmax.x - lmin.x) * (lmax.z - lmin.z);
        float w = max((area * cosTheta * cosLight) / d2, 0.0001);
        weights[i] = w;
        totalWeight += w;
    }
    if (totalWeight <= 0.0) return 0.0;
    return weights[chosenIdx] / totalWeight;
}

float lightPdf(vec3 hitPoint, vec3 hitNormal, int chosenIdx, vec3 dir, float dist) {
    vec3 lmin = lightBuffer.lights[chosenIdx].minP.xyz;
    vec3 lmax = lightBuffer.lights[chosenIdx].maxP.xyz;
    float area = (lmax.x - lmin.x) * (lmax.z - lmin.z);
    if (area <= 0.0) return 0.0;

    float cosLight = max(dot(vec3(0.0, -1.0, 0.0), -dir), 0.0);
    if (cosLight <= 0.0) return 0.0;

    float pSelect = lightSelectPdf(hitPoint, hitNormal, chosenIdx);
    float pArea = pSelect * (1.0 / area);
    return pArea * (dist * dist) / cosLight;
}

vec3 sampleDirectLight(vec3 hitPoint, vec3 hitNormal, vec3 wo, HitInfo surf) {
    if (lightBuffer.count == 0) return vec3(0.0);
    if (pc.lightMode == 1) return vec3(0.0);

    float weights[MAX_LIGHTS];
    float totalWeight = 0.0;

    for (int i = 0; i < lightBuffer.count; i++) {
        vec3 lmin = lightBuffer.lights[i].minP.xyz;
        vec3 lmax = lightBuffer.lights[i].maxP.xyz;
        vec3 center = 0.5 * (lmin + lmax);
        vec3 toCenter = center - hitPoint;
        float d2 = max(dot(toCenter, toCenter), 0.01);

        vec3 dir = toCenter / sqrt(d2);
        float cosTheta = max(dot(hitNormal, dir), 0.0);
        float cosLight = max(dot(vec3(0.0, -1.0, 0.0), -dir), 0.0);

        float area = (lmax.x - lmin.x) * (lmax.z - lmin.z);
        float w = max((area * cosTheta * cosLight) / d2, 0.0001);

        weights[i] = w;
        totalWeight += w;
    }
    if (totalWeight <= 0.0) return vec3(0.0);

    float r = randomFloat() * totalWeight;
    float cumulative = 0.0;
    int chosenIdx = 0;
    for (int i = 0; i < lightBuffer.count; i++) {
        cumulative += weights[i];
        if (r <= cumulative || i == lightBuffer.count - 1) { chosenIdx = i; break; }
    }

    vec3 lmin = lightBuffer.lights[chosenIdx].minP.xyz;
    vec3 lmax = lightBuffer.lights[chosenIdx].maxP.xyz;
    vec3 lightRadiance = lightBuffer.lights[chosenIdx].radiance.xyz;
    float pSelect = weights[chosenIdx] / totalWeight;

    vec3 lightPoint = vec3(
        mix(lmin.x, lmax.x, randomFloat()),
        lmin.y,
        mix(lmin.z, lmax.z, randomFloat())
    );

    vec3 toLight = lightPoint - hitPoint;
    float distSqr = dot(toLight, toLight);
    float dist = sqrt(distSqr);
    vec3 wi = toLight / dist;

    vec3 lightNormal = vec3(0.0, -1.0, 0.0);
    float NdotL = max(dot(hitNormal, wi), 0.0);
    float NdotLLight = max(dot(lightNormal, -wi), 0.0);
    if (NdotL <= 0.0 || NdotLLight <= 0.0) return vec3(0.0);

    Ray shadowRay = Ray(hitPoint + hitNormal * 0.001, wi);
    HitInfo shadowHit;
    if (!intersectScene(shadowRay, shadowHit)) return vec3(0.0);
    if (!shadowHit.isLight || abs(shadowHit.t - dist) > 0.01) return vec3(0.0);

    float lightArea = (lmax.x - lmin.x) * (lmax.z - lmin.z);

    float pAreaLight = pSelect * (1.0 / lightArea);
    float pdfLight = pAreaLight * distSqr / NdotLLight;

    vec3 brdf;
    float pdfBsdf;
    if (surf.isGlossy) {
        brdf = glossyBrdf(hitNormal, wo, wi, surf.roughness, surf.color);
        pdfBsdf = glossyPdf(hitNormal, wo, wi, surf.roughness);
    } else {
        brdf = surf.color / PI;
        pdfBsdf = NdotL / PI;
    }

    float misWeight = 1.0;
    if (pc.lightMode == 2) {
        misWeight = 0.5;
    } else if (pc.lightMode == 3) {
        misWeight = powerHeuristic(pdfLight, pdfBsdf);
    }

    vec3 contribution = misWeight * (lightRadiance * brdf * NdotL * NdotLLight * lightArea) / (distSqr * pSelect);
    if (pc.useClamp == 1) contribution = min(contribution, vec3(DIRECT_CLAMP));
    return contribution;
}

//==============================================================================

vec3 tracePath(Ray ray) {
    vec3 throughput = vec3(1.0);
    vec3 color = vec3(0.0);

    float prevBsdfPdf = -1.0;
    vec3 prevNormal = vec3(0.0, 1.0, 0.0);

    for (int bounce = 0; bounce < pc.maxBounces; bounce++) {
        HitInfo hit;
        if (!intersectScene(ray, hit)) break;

        vec3 hitPoint = ray.origin + hit.t * ray.dir;

        if (hit.isLight) {
            int li = findLightIndex(hitPoint);
            vec3 Le = (li >= 0) ? lightBuffer.lights[li].radiance.xyz : LIGHT_RADIANCE;

            if (bounce == 0) {
                color += throughput * Le;
            } else if (pc.lightMode == 1 || pc.lightMode == 2) {
                float bsdfWeight = (pc.lightMode == 2) ? 0.5 : 1.0;
                vec3 lightContribution = throughput * Le * bsdfWeight;
                if (pc.useClamp == 1) lightContribution = min(lightContribution, vec3(DIRECT_CLAMP));
                color += lightContribution;
            } else if (pc.lightMode == 3) {
                float pdfLight = 0.0;
                if (li >= 0) {
                    pdfLight = lightPdf(ray.origin, prevNormal, li, ray.dir, hit.t);
                }
                float misWeight = powerHeuristic(prevBsdfPdf, pdfLight);
                vec3 lightContribution = throughput * Le * misWeight;
                if (pc.useClamp == 1) lightContribution = min(lightContribution, vec3(DIRECT_CLAMP));
                color += lightContribution;
            }

            break;
        }

        vec3 shadingPoint = hitPoint + hit.normal * 0.001;
        vec3 hitNormal = hit.normal;
        vec3 wo = -ray.dir;

        HitInfo surf = hit;
        if (!hit.isGlossy) {
            surf.color = hit.color;
        }

        vec3 direct = sampleDirectLight(shadingPoint, hitNormal, wo, surf);
        color += throughput * direct;

        vec3 wi;
        if (surf.isGlossy) {
            vec3 h = sampleGGXHalfVector(hitNormal, surf.roughness);
            wi = reflect(-wo, h);
            if (dot(wi, hitNormal) <= 0.0) break;

            float pdfH = glossyPdf(hitNormal, wo, wi, surf.roughness);
            prevBsdfPdf = pdfH;

            vec3 brdf = glossyBrdf(hitNormal, wo, wi, surf.roughness, surf.color);
            float NdotL = max(dot(hitNormal, wi), 0.0);
            throughput *= (brdf * NdotL) / max(pdfH, 1e-7);
        } else {
            wi = cosineSampleHemisphere(hitNormal);
            float NdotL = max(dot(hitNormal, wi), 0.0);
            prevBsdfPdf = NdotL / PI;
            throughput *= surf.color;
        }

        ray.origin = shadingPoint + hitNormal * 0.001;
        ray.dir = wi;
        prevNormal = hitNormal;

        float survivalProb = min(1.0, max(throughput.r, max(throughput.g, throughput.b)));
        if (randomFloat() > survivalProb) break;
        throughput /= survivalProb;
    }

    return color;
}

//==============================================================================

vec3 reprojectToPreviousPixel(vec3 worldPos, ivec2 size) {
    vec3 rel = worldPos - camera.prevPosition.xyz;
    float t = dot(rel, camera.prevForward.xyz);
    if (t <= 0.001) return vec3(-1.0, -1.0, 0.0);

    float aspect = float(size.x) / float(size.y);
    float x = dot(rel, camera.prevRight.xyz) / t / aspect;
    float y = -dot(rel, camera.prevUp.xyz) / t;

    vec2 uv = vec2(x, y) * 0.5 + 0.5;
    return vec3(uv * vec2(size) - 0.5, t);
}

vec4 sampleHistory(vec2 pixelCoord, ivec2 size) {
    if (pixelCoord.x < 0.0 || pixelCoord.y < 0.0 ||
        pixelCoord.x > float(size.x - 1) || pixelCoord.y > float(size.y - 1)) {
        return vec4(-1.0);
    }

    ivec2 p0 = ivec2(floor(pixelCoord));
    vec2 f = fract(pixelCoord);

    ivec2 p00 = clamp(p0, ivec2(0), size - 1);
    ivec2 p10 = clamp(p0 + ivec2(1, 0), ivec2(0), size - 1);
    ivec2 p01 = clamp(p0 + ivec2(0, 1), ivec2(0), size - 1);
    ivec2 p11 = clamp(p0 + ivec2(1, 1), ivec2(0), size - 1);

    vec4 top = mix(imageLoad(previousFrameImage, p00), imageLoad(previousFrameImage, p10), f.x);
    vec4 bottom = mix(imageLoad(previousFrameImage, p01), imageLoad(previousFrameImage, p11), f.x);

    return mix(top, bottom, f.y);
}

void accumulateAverage(ivec2 pixel, vec3 col, float depth) {
    vec3 oldColor = imageLoad(previousFrameImage, pixel).rgb;
    float weight = 1.0 / max(float(pc.frameCount), 1.0);
    vec3 accumulated = mix(oldColor, col, weight);
    if (pc.useClamp == 1) accumulated = min(accumulated, vec3(ACCUM_CLAMP));
    imageStore(outputImage, pixel, vec4(accumulated, depth));
}

void accumulateTAA(ivec2 pixel, ivec2 size, vec3 col, HitInfo primaryHit, bool didHit) {
    vec2 centerUV = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    centerUV.x *= float(size.x) / float(size.y);
    centerUV.y = -centerUV.y;

    vec3 rayDir = normalize(camera.forward.xyz + centerUV.x * camera.right.xyz + centerUV.y * camera.up.xyz);
    vec3 worldPos = camera.position.xyz + primaryHit.t * rayDir;
    float depth = didHit ? dot(worldPos - camera.position.xyz, camera.forward.xyz) : 1e30;

    float historyWeight = 0.0;
    vec4 history = vec4(-1.0);

    if (didHit && pc.frameCount > 1) {
        vec3 reprojected = reprojectToPreviousPixel(worldPos, size);

        if (reprojected.z > 0.0) {
            history = sampleHistory(reprojected.xy, size);

            if (history.r >= 0.0) {
                float expectedPrevDepth = dot(worldPos - camera.prevPosition.xyz, camera.prevForward.xyz);
                float depthDiff = abs(expectedPrevDepth - history.a) / max(expectedPrevDepth, 0.001);

                if (depthDiff < DEPTH_REJECT_TOL) {
                    historyWeight = HISTORY_WEIGHT;
                } else {
                    historyWeight = HISTORY_WEIGHT_NEW;
                }
            }
        }
    }

    vec3 accumulated = mix(col, history.rgb, historyWeight);
    if (pc.useClamp == 1) accumulated = min(accumulated, vec3(ACCUM_CLAMP));
    imageStore(outputImage, pixel, vec4(accumulated, depth));
}

//==============================================================================

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    rngState = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pc.frameCount * 26699u + 1u;

    vec2 centerUV = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    centerUV.x *= float(size.x) / float(size.y);
    centerUV.y = -centerUV.y;
    Ray primaryRay = Ray(camera.position.xyz, normalize(camera.forward.xyz + centerUV.x * camera.right.xyz + centerUV.y * camera.up.xyz));

    if (pc.debugHeatmap == 1) {
        HitInfo th;
        th.t = 1e30;
        int tests = (pc.useBVH == 1) ? hitBVHTests(primaryRay, th) : hitLinearTests(primaryRay, th);
        imageStore(outputImage, pixel, vec4(heatmap(float(tests) / max(pc.heatmapMax, 1.0)), 1.0));
        return;
    }

    HitInfo primaryHit;
    bool didHit = intersectScene(primaryRay, primaryHit);

    bool needGBuffer = (pc.useTAA == 1) || (pc.useAtrous == 1);

    vec3 albedo = vec3(1.0);
    float depth = 1e30;
    if (needGBuffer) {
        vec3 hitPoint = primaryRay.origin + primaryHit.t * primaryRay.dir;
        albedo = didHit ? (primaryHit.isLight ? LIGHT_COLOR : primaryHit.color) : BACKGROUND_COLOR;
        depth = didHit ? dot(hitPoint - camera.position.xyz, camera.forward.xyz) : 1e30;
        imageStore(gNormalDepth, pixel, vec4(didHit ? primaryHit.normal : vec3(0.0, 1.0, 0.0), depth));
        imageStore(gAlbedo, pixel, vec4(albedo, 1.0));
    }

    vec3 col = vec3(0.0);

    for (int s = 0; s < int(pc.samples); s++) {
        col += tracePath(generateCameraRay(pixel, size));
    }

    col /= float(pc.samples);

    if (pc.useAtrous == 1) {
        col /= max(albedo, vec3(0.04));
    }

    if (pc.useTAA == 1) {
        accumulateTAA(pixel, size, col, primaryHit, didHit);
    } else {
        accumulateAverage(pixel, col, depth);
    }
}