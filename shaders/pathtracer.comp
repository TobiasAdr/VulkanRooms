#version 450

//#define FURNITURE
#define BOX

struct Triangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 normal;
};

struct BVHNode {
    vec3 aabbMin;
    int leftChild;
    vec3 aabbMax;
    int rightChild;
    int triangleStart;
    int triangleCount;
    float padding0;
    float padding1;
};

struct Ray {
    vec3 origin;
    vec3 dir;
};

struct HitInfo {
    float t;
    vec3 normal;
    vec3 color;
    bool isLight;
};


layout(local_size_x = 8, local_size_y = 8) in;


layout(rgba32f, set = 0, binding = 0) uniform image2D outImage;

layout(push_constant) uniform PushConstants {

    uint frameCount;

} pc;


layout(binding = 1) readonly buffer TriangleBuffer {

    Triangle triangles[];

} triBuffer;

layout(binding = 2) readonly buffer BVHBuffer {

    BVHNode nodes[];

} bvhBuffer;

const vec3 lightMin = vec3(-0.24, 1.99, 0.2);
const vec3 lightMax = vec3( 0.24, 1.99, 0.6);

// ------------- RANDOM -------------

uint rngState;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand() {
    rngState = pcg(rngState);
    return float(rngState) / float(0xFFFFFFFFu);
}

vec3 randomHemisphere(vec3 normal) {
    float u1 = rand();
    float u2 = rand();

    float r   = sqrt(u1);
    float phi = 2.0 * 3.14159265 * u2;

    vec3 localDir = vec3(r * cos(phi), r * sin(phi), sqrt(1.0 - u1));

    vec3 up      = abs(normal.y) < 0.9 ? vec3(0,1,0) : vec3(1,0,0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitang  = cross(normal, tangent);

    return normalize(tangent * localDir.x + bitang * localDir.y + normal * localDir.z);
}

// ---------------- RANDOM ----------------

bool hitQuad(Ray ray, vec3 minP, vec3 maxP, vec3 normal, vec3 color, bool isLight, inout HitInfo closest) {
    
    // The normal is the normal coming out from the wall. For example, the floor has a plane normal going upwards, giving : vec3(0, 1, 0) (y=1)
    // And, the right wall has a normal going left, vec3(-1,0,0) (x=-1)

    float denom = dot(normal, ray.dir);

    if (abs(denom) < 0.0001) return false;

    vec3 planePoint = (minP + maxP) * 0.5;
    float planeD = dot(normal, planePoint);
    float t = (planeD - dot(normal, ray.origin)) / denom;
    
    if (t < 0.001 || t >= closest.t) return false;

    vec3 p = ray.origin + t * ray.dir;


    if (abs(normal.x) > 0.5) {
    
        if (p.y < minP.y || p.y > maxP.y) return false;
        if (p.z < minP.z || p.z > maxP.z) return false;
    
    } else if (abs(normal.y) > 0.5) {
    
        if (p.x < minP.x || p.x > maxP.x) return false;
        if (p.z < minP.z || p.z > maxP.z) return false;
    
    } else {

        if (p.x < minP.x || p.x > maxP.x) return false;
        if (p.y < minP.y || p.y > maxP.y) return false;
    
    }

    closest.t = t;
    closest.normal = denom < 0.0 ? normal : -normal;
    closest.color = color;
    closest.isLight = isLight;
    return true;

}

bool hitTriangle(Ray ray, Triangle tri, inout HitInfo closest) {

    vec3 v0 = tri.v0.xyz;
    vec3 v1 = tri.v1.xyz;
    vec3 v2 = tri.v2.xyz;

    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 h = cross(ray.dir, e2);
    float a = dot(e1, h);

    if (abs(a) < 0.0001) return false;

    float f = 1.0 / a;
    vec3 s = ray.origin - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, e1);
    float v = f * dot(ray.dir, q);
    if (v < 0.0 || u + v > 1.0) return false;

    float t = f * dot(e2, q);
    if (t < 0.001 || t >= closest.t) return false;

    closest.t = t;
    closest.normal = tri.normal.xyz;
    closest.color = vec3(0.8, 0.8, 0.8);
    closest.isLight = false;
    return true;

}

bool triangleLoop(Ray ray, inout HitInfo hit) {

    bool didHit = false;
   
    for (int i = 0; i < triBuffer.triangles.length(); i++) {
   
        didHit = hitTriangle(ray, triBuffer.triangles[i], hit) || didHit;
   
    }
    return didHit;

}

bool hitAABB(Ray ray, vec3 aabbMin, vec3 aabbMax, float tMax){

    vec3 invDir = 1.0 / ray.dir; // to avoid division since its more expensive than multiplication
    
    vec3 t0 = (aabbMin - ray.origin) * invDir;
    vec3 t1 = (aabbMax - ray.origin) * invDir;
    
    // from which way does it enter the box
    vec3 tMin = min(t0, t1); 
    vec3 tMax3 = max(t0, t1);
    
    // the largest tMin is the entry point, the smallest tMax is the exit point
    float tEnter = max(max(tMin.x, tMin.y), tMin.z);
    float tExit  = min(min(tMax3.x, tMax3.y), tMax3.z);

    // check if x, y and z interval are all inside the box at the same time.
    return tEnter <= tExit && tExit > 0.001 && tEnter < tMax;

}

bool hitBVH(Ray ray, inout HitInfo hit){

    bool didHit = false;
    int stack[32]; 
    int stackPtr = 0;
    stack[stackPtr++] = 0; // Root

    while(stackPtr > 0 ){

        int nodeIdx = stack[--stackPtr]; 
        BVHNode node = bvhBuffer.nodes[nodeIdx];

        if(!hitAABB(ray, node.aabbMin, node.aabbMax, hit.t)) continue;

        if(node.triangleCount > 0){

           for(int i = node.triangleStart; i < node.triangleStart + node.triangleCount; i++){
               
                didHit = hitTriangle(ray, triBuffer.triangles[i], hit) || didHit;
            
            }

        } else {
         
            stack[stackPtr++] = node.leftChild; // writes over root index. 
            stack[stackPtr++] = node.rightChild;
        
        }

    }

    return didHit;

}

bool hitScene(Ray ray, inout HitInfo hit) {

    hit.t = 1e30;
    bool didHit = false;

    vec3 backRoomsWall = vec3(0.86, 0.78, 0.29);
    vec3 lightColor = vec3(1.0, 0.96, 0.80);

    didHit = hitQuad(ray, vec3(-1, 0,0), vec3( 1, 0, 2), vec3(0, 1,0),  backRoomsWall, false, hit) || didHit; // Floor
    didHit = hitQuad(ray, vec3(-1, 2,0), vec3( 1, 2, 2), vec3(0,-1,0),  backRoomsWall, false, hit) || didHit; // Roof
    didHit = hitQuad(ray, vec3(-1, 0,0), vec3(-1, 2, 2), vec3(1, 0,0),  backRoomsWall, false, hit) || didHit; // Left
    didHit = hitQuad(ray, vec3( 1, 0,0), vec3( 1, 2, 2), vec3(-1,0,0),  backRoomsWall, false, hit) || didHit; // Right
    didHit = hitQuad(ray, vec3(-1, 0,0), vec3( 1, 2, 2), vec3(0, 0,-1), backRoomsWall, false, hit) || didHit; // Back

    didHit = hitQuad(ray, lightMin, lightMax, vec3(0,-1,0), lightColor, true, hit) || didHit; // Light

    didHit = triangleLoop(ray, hit) || didHit;

    //didHit = hitBVH(ray, hit) || didHit;

    vec3 boxMin = vec3(-0.4, 0.0, 0.33);
    vec3 boxMax = vec3( 0.0, 0.6, 0.53);
    vec3 boxColor = vec3(0.8);

    // --------------- FURNITURE ---------------------------

    #ifdef FURNITURE
        // BOX
        didHit = hitQuad(ray, vec3(boxMin.x, boxMax.y, boxMin.z), vec3(boxMax.x, boxMax.y, boxMax.z), vec3(0,-1,0), boxColor, false, hit) || didHit;
        didHit = hitQuad(ray, vec3(boxMin.x, boxMin.y, boxMin.z), vec3(boxMax.x, boxMin.y, boxMax.z), vec3(0,1,0), boxColor, false, hit) || didHit;
        didHit = hitQuad(ray, vec3(boxMin.x, boxMin.y, boxMin.z), vec3(boxMin.x, boxMax.y, boxMax.z), vec3(1,0,0), boxColor, false, hit) || didHit;
        didHit = hitQuad(ray, vec3(boxMax.x, boxMin.y, boxMin.z), vec3(boxMax.x, boxMax.y, boxMax.z), vec3(-1,0,0), boxColor, false, hit) || didHit;
        didHit = hitQuad(ray, vec3(boxMin.x, boxMin.y, boxMax.z), vec3(boxMax.x, boxMax.y, boxMax.z), vec3(0,0,-1), boxColor, false, hit) || didHit;
        didHit = hitQuad(ray, vec3(boxMin.x, boxMin.y, boxMin.z), vec3(boxMax.x, boxMax.y, boxMin.z), vec3(0,0,1), boxColor, false, hit) || didHit;
    
    #endif


    return didHit;

}


Ray generateRay(ivec2 pixel, ivec2 size) {

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    uv.x *= float(size.x) / float(size.y);
    uv.y = -uv.y;
 
    vec3 cameraPos = vec3(0.0, 1.0, -1.0);

    Ray ray;
    ray.origin = cameraPos;
    ray.dir    = normalize(vec3(uv.x, uv.y, 1.0));
    return ray;

}


vec3 tracePath(Ray ray) {

    vec3 throughput = vec3(1.0);
    vec3 color      = vec3(0.0);

    const int MAX_BOUNCES = 8;

    for (int bounce = 0; bounce < MAX_BOUNCES; bounce++) {

        HitInfo hit;
        if (!hitScene(ray, hit)) break;

        if (hit.isLight) {
            color += throughput * vec3(15.0);
            break;
        }

        vec3 hitPoint = ray.origin + hit.t * ray.dir + hit.normal * 0.001;

        ray.origin = hitPoint;
        ray.dir    = randomHemisphere(hit.normal);

        throughput *= hit.color;

        float p = max(throughput.r, max(throughput.g, throughput.b));
        if (rand() > p) break;
        throughput /= p;
    }

    return color;

}

void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    
    ivec2 size  = imageSize(outImage);

    rngState = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + pc.frameCount * 26699u + 1u;

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    const int SAMPLES = 4;
    vec3 col = vec3(0.0);

    for (int s = 0; s < SAMPLES; s++) {
        Ray ray = generateRay(pixel, size);
        col += tracePath(ray);
    }

    col /= float(SAMPLES);

    vec3 oldColor    = imageLoad(outImage, pixel).rgb;
    vec3 accumulated = (oldColor * float(pc.frameCount) + col) / float(pc.frameCount + 1);

    imageStore(outImage, pixel, vec4(accumulated, 1.0));

}